{
  "name": "bm_R13_technical_gpu1_v2",
  "env": {
    "CUDA_VISIBLE_DEVICES": "1",
    "HF_HUB_OFFLINE": "1",
    "TRANSFORMERS_OFFLINE": "1",
    "TOKENIZERS_PARALLELISM": "false",
    "OMP_NUM_THREADS": "4",
    "MKL_NUM_THREADS": "4",
    "PYTHONUTF8": "1",
    "PYTHONIOENCODING": "utf-8",
    "TRITON_CACHE_DIR": "${DATA_ROOT}/cache/round13_v1/triton",
    "TMPDIR": "${DATA_ROOT}/cache/round13_v1/tmp",
