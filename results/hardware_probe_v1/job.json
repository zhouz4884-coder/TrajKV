{
  "name": "hardware_probe_v1",
  "env": {
    "CUDA_VISIBLE_DEVICES": "0",
    "HF_HUB_OFFLINE": "1",
    "HF_HUB_DISABLE_PROGRESS_BARS": "1",
    "TOKENIZERS_PARALLELISM": "false"
  },
  "argv": [
    "timeout",
    "180s",
    "/usr/local/cuda/bin/ncu",
    "--profile-from-start",
    "off",
    "--devices",
    "0",
    "--kernel-regex",
    "_read.*",
    "--launch-count",
    "2",
    "--metrics",
    "dram__bytes_read.sum,dram__bytes_write.sum",
    "--cache-control",
    "none",
    "--clock-control",
    "none",
    "--replay-mode",
    "kernel",
    "--target-processes",
    "application-only",
    "--csv",
    "--page",
    "raw",
    "--print-units",
    "base",
    "--log-file",
    "/path/to/TrajKV/results/hardware_probe_v1/raw_metrics.csv",
    "--export",
    "/path/to/TrajKV/results/hardware_probe_v1/profile",
    "/home/RESEARCHER/miniconda3/envs/p72_modern_vlm/bin/python",
    "-u",
    "/path/to/TrajKV/code/experiments/profile_probe.py",
    "--model",
    "/path/to/InternVL3-8B-hf",
    "--samples",
    "/path/to/TrajKV/configs/data/clevr_dev32_runner.json",
    "--legacy-scripts",
    "/path/to/VisContract_P14_2/scripts",
    "--kivi-source",
    "/path/to/VisContract_P14_2/third_party/KIVI/quant/new_pack.py",
    "--output",
    "/path/to/TrajKV/results/hardware_probe_v1"
  ]
}
